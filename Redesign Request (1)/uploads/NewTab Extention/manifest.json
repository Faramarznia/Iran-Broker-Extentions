{
  "manifest_version": 3,
  "name": "ایران بروکر | تب جدید",
  "short_name": "IranBroker NewTab",
  "version": "1.0.0",
  "description": "داشبورد تب جدید ایران بروکر — سرچ گوگل، قیمت لحظه‌ای ارز دیجیتال، ابزارهای فارکس، تقویم اقتصادی و دسترسی سریع.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.coingecko.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.coingecko.com;"
  }
}
